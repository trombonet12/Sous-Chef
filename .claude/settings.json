{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(./gradlew.bat *)",
      "Bash(scripts/sc *)",
      "Bash(scripts/sc.cmd *)",
      "Bash(node scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(python -I scripts/*)",
      "Bash(docker ps*)",
      "Bash(docker info*)",
      "Bash(adb *)",
      "Bash(keytool *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git ls-files*)",
      "Bash(git push origin main)",
      "Bash(git push)",
      "Write(.claude/agents/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/skills/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/warn-generated.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-commands.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-lint.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}